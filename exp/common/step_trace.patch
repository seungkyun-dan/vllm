+    def _trace_step(
+        self,
+        num_scheduled_tokens: dict[str, int],
+        total_num_scheduled_tokens: int,
+    ) -> None:
+        if not self.step_trace_path:
+            return
+
+        prefill_tokens = 0
+        decode_reqs = 0
+        for req_id, num_tokens in num_scheduled_tokens.items():
+            request = self.requests.get(req_id)
+            if request is None:
+                continue
+            prompt_remaining = max(
+                request.num_prompt_tokens - request.num_computed_tokens, 0
+            )
+            req_prefill_tokens = min(num_tokens, prompt_remaining)
+            prefill_tokens += req_prefill_tokens
+            if num_tokens > req_prefill_tokens:
+                decode_reqs += 1
+
+        with open(self.step_trace_path, "a", encoding="utf-8") as trace_file:
+            trace_file.write(
+                json.dumps(
+                    {
+                        "ts": time.time(),
+                        "step_id": self.current_step,
+                        "total_scheduled_tokens": total_num_scheduled_tokens,
+                        "prefill_tokens": prefill_tokens,
+                        "decode_reqs": decode_reqs,
+                        "num_running": len(self.running),
+                        "num_waiting": len(self.waiting)
+                        + len(self.skipped_waiting)
+                        - self.num_waiting_for_streaming_input,
+                        "kv_usage": self.kv_cache_manager.usage,
+                    },
+                    separators=(",", ":"),
+                )
+                + "\n"
+            )
+
